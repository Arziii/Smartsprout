# ──────────────────────────────────────────────────────────
# Smart Sprout — Raspberry Pi Hardware Configuration
# Copy this file to .env and fill in your actual values.
# ──────────────────────────────────────────────────────────

# ── Network ──
PI_IP_ADDRESS=192.168.1.100
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# ── I2C Bus Devices ──
ADS1115_I2C_ADDRESS=0x48
ADS1115_I2C_BUS=1

# ── BMP280 Temperature & Pressure Sensor ──
# Physical chip confirmed: BMP280 (Chip ID 0x58). NOT a BME280.
# Humidity is NOT available on this sensor — hardcoded to null in telemetry.
BMP280_I2C_ADDRESS=0x76

# ── GPIO Pin Mapping (BCM Mode) ──
# XKC_LEVEL_PIN — Non-contact liquid level sensor signal pin
XKC_LEVEL_PIN=5

# XKC-Y26-V Non-contact Liquid Level Sensor
TANK_LOW_PIN=5

# YF-S201 Water Flow Sensor
FLOW_SENSOR_PIN=13

# 4-Channel Relay Module
RELAY_PUMP_PIN=17
RELAY_VALVE1_PIN=27
RELAY_VALVE2_PIN=22
RELAY_VALVE3_PIN=23

# ── Sensor Calibration ──
# Soil sensor raw ADC range (dry=high, wet=low for capacitive)
SOIL_SENSOR_DRY=12491
SOIL_SENSOR_WET=6165

# Tank dimensions (cm) for volume calculation
TANK_HEIGHT_CM=40
TANK_EMPTY_DISTANCE_CM=40
TANK_FULL_DISTANCE_CM=5

# Flow sensor calibration (pulses per liter)
FLOW_CALIBRATION_FACTOR=7.5

# ── Safety Thresholds ──
TANK_LOW_THRESHOLD=10
BATTERY_LOW_THRESHOLD=20

# ── Telemetry Interval (seconds) ──
TELEMETRY_INTERVAL=3
CLOUD_SYNC_INTERVAL=1800
