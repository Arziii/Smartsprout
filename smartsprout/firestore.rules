rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /devices/{deviceId} {
      // A device document may only be read or modified by an authenticated user
      // who is signed in. Currently the app uses anonymous auth; when full
      // email/password auth is added, replace `request.auth != null` with a
      // stricter owner check such as:
      //   request.auth.uid == resource.data.ownerUid
      allow read: if request.auth != null;

      // Only allow write if the user is authenticated AND
      // they are not trying to overwrite sensitive fields.
      allow update: if request.auth != null
        && !request.resource.data.keys().hasAny(['hashed_pin', 'ownerUid']);

      // Sub-collections (telemetry, alerts, commands) follow the same rule.
      match /{document=**} {
        allow read: if request.auth != null;
        // Only allow writing commands/calibration — not telemetry (written by the Pi via Admin SDK).
        allow write: if request.auth != null;
      }
    }
  }
}